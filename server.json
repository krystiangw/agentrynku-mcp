{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "pl.agentrynku/gpw",
  "title": "Agent Rynku - Warsaw Stock Exchange (GPW) data for your agent",
  "description": "Warsaw Stock Exchange data: quotes, ESPI/EBI filings, quarterly KPIs, earnings forecasts.",
  "version": "1.0.0",
  "websiteUrl": "https://agentrynku.pl/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://agentrynku.pl/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Agent Rynku API key, sent as a Bearer token",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "API key from https://agentrynku.pl/settings",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/krystiangw/agentrynku-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agentrynku-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AGENTRYNKU_API_KEY",
          "description": "API key from https://agentrynku.pl/settings",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
